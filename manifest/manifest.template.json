{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "supportsChannelFeatures": "tier1",
  "version": "1.0.4",
  "id": "__APP_ID__",
  "developer": {
    "name": "HCI",
    "websiteUrl": "https://hci-tv.com",
    "privacyUrl": "https://hci-tv.com/privacy",
    "termsOfUseUrl": "https://hci-tv.com/terms"
  },
  "name": {
    "short": "HCI ONE",
    "full": "HCI ONE"
  },
  "description": {
    "short": "HCI customers, projects and tasks, in the channel that runs them",
    "full": "Adds an HCI ONE tab to a channel: project overview, plan and tasks, files, team, integrations and size and hardware for the customer project the channel is about. The personal tab shows the daily task board and every customer."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#19B34A",
  "configurableTabs": [
    {
      "configurationUrl": "https://__HOST__/config.html",
      "canUpdateConfiguration": true,
      "scopes": [
        "team",
        "groupChat"
      ],
      "context": [
        "channelTab",
        "privateChatTab"
      ]
    }
  ],
  "staticTabs": [
    {
      "entityId": "portfolio",
      "name": "Portfolio",
      "contentUrl": "https://__HOST__/?scope=portfolio",
      "websiteUrl": "https://__HOST__/?scope=portfolio",
      "scopes": [
        "personal"
      ]
    }
  ],
  "permissions": [
    "identity"
  ],
  "validDomains": [
    "__HOST__"
  ],
  "webApplicationInfo": {
    "id": "__ENTRA_APP_ID__",
    "resource": "api://__HOST__/__ENTRA_APP_ID__"
  }
}